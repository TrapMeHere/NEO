# Keep text files reviewable across Windows/Linux; binaries must never be
# converted. Existing files are not renormalized in this change (that would
# create a huge diff); future edits follow these rules.
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.otf binary
*.ttf binary
*.ttc binary
*.ico binary
*.png binary
*.pbf binary
*.joz binary
