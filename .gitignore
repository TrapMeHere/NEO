# Cargo build cache actually lives in out/cargo (.cargo/config.toml); this only blocks the old accidental path.
/target

# Preset packages (package-lock.json is committed)
/node_modules

# Generated preset catalog (~15 MB); rebuild with node scripts/build-presets.mjs
/assets/presets/presets.gen.json
/assets/presets/schema.neo
/assets/presets/suggestions.neo
**/*.rs.bk

# Research artifacts (crate sources, JOSM sources, cheat-sheets) are local-only
/.research

# Prototype outputs
/out
*.png.tmp
*.log

# Python bytecode
__pycache__/
*.pyc

# mdBook build output
/book

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
